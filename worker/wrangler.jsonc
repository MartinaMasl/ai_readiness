{
  "name": "ai-readiness",
  "main": "src/main.py",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["python_workers"],

  // Files in public/ are served directly (so / shows index.html).
  // Requests that match no file, like /api, go to the FastAPI app.
  "assets": {
    "directory": "./public"
  }
}
